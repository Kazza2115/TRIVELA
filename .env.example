# Supabase — create a project at https://supabase.com then copy your project URL and anon key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostHog (analytics : clics, pages vues, rétention, funnels).
# Crée un projet sur https://posthog.com → Project Settings → copie la "Project API Key".
# Sans ces variables, PostHog est ignoré et seul l'analytics Supabase (db-analytics.sql) tourne.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Hôte de l'instance PostHog. UE par défaut ; US = https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
